<Window x:Class="SevenDaysModLauncher.Views.NexusDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Mods — download &amp; updates"
        Width="640" Height="700" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Auth -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="NEXUS LOGIN" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="OAuthButton" Content="Login with Nexus"
                        Padding="16,0" MinHeight="36" Margin="0,0,8,4"
                        Style="{DynamicResource AccentButtonStyle}" Click="OAuthButton_Click"
                        ToolTip="OAuth PKCE via browser (needs appid from Nexus Support)"/>
                <TextBox x:Name="ApiKeyBox" MinWidth="180" Width="220" Margin="0,0,8,4"
                         ToolTip="Personal API key: My Account → API Access (fallback without OAuth)"/>
                <Button x:Name="ValidateButton" Content="Use key"
                        Padding="16,0" MinHeight="36" Margin="0,0,0,4"
                        Style="{DynamicResource GhostButtonStyle}" Click="ValidateButton_Click"/>
            </WrapPanel>
            <TextBlock x:Name="AuthStatusText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Mod link -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="MOD LINK OR ID" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ModLinkBox" Grid.Column="0" Margin="0,0,8,0"
                         ToolTip="https://www.nexusmods.com/7daystodie/mods/10784 or just 10784"/>
                <Button x:Name="FindButton" Grid.Column="1" Content="Find"
                        Padding="16,0" MinHeight="36"
                        Style="{DynamicResource AccentButtonStyle}" Click="FindButton_Click"/>
            </Grid>
            <TextBlock x:Name="ModTitleText" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ModAuthorText" FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            <TextBlock x:Name="MatchText" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource AccentHoverBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Files -->
        <TextBlock Grid.Row="2" Text="FILES" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
        <ListView x:Name="FilesList" Grid.Row="3" SelectionMode="Single"
                  VirtualizingStackPanel.IsVirtualizing="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF101724" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayMeta}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" FontSize="12"
                                       Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Maximum="1" Height="8"/>
            <TextBlock x:Name="DownloadStatusText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenSiteButton" Content="🌐 Website"
                    Padding="18,8" Style="{DynamicResource GhostButtonStyle}"
                    ToolTip="Open the mod files page in a browser (manual download without Premium)"
                    Click="OpenSiteButton_Click"/>
            <Button x:Name="DownloadButton" Content="⬇ Download &amp; Install"
                    Padding="18,8" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                    Click="DownloadButton_Click"/>
            <Button Content="Close" IsCancel="True" Padding="18,8" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
