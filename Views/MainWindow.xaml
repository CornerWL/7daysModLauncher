<Window x:Class="SevenDaysModLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SevenDaysModLauncher.ViewModels"
        mc:Ignorable="d"
        Title="7 Days to Die — Mod Launcher"
        Icon="/logo.ico"
        Height="680"
        Width="1020"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="46" Height="46" CornerRadius="6" Margin="0,0,12,0">
                <Border.Background>
                    <ImageBrush ImageSource="/logo.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="7 DAYS TO DIE" FontSize="22" FontWeight="ExtraBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Border Background="#FF16233A" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Mods.Count, StringFormat='{}{0} mods'}" FontSize="12"
                                   Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding EnabledCount, StringFormat='{}{0} enabled'}" FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Install mod" Command="{Binding InstallModCommand}"
                        Padding="18,10" Margin="0,0,10,0"
                        Style="{DynamicResource AccentButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}"/>
                <Button Content="⬇ Nexus" Command="{Binding OpenNexusDownloadCommand}"
                        Padding="18,10" Margin="0,0,10,0"
                        Style="{DynamicResource GhostButtonStyle}"
                        IsEnabled="{Binding IsNotBusy}" ToolTip="Nexus Mods: login, browse files, download, check updates"/>
                <Button Content="▶  Play" Command="{Binding LaunchGameCommand}"
                        Padding="28,10" MinWidth="130"
                        Style="{DynamicResource PlayButtonStyle}"
                        IsEnabled="{Binding CanLaunchGame}" ToolTip="Launch the game"/>
            </StackPanel>
        </Grid>

        <!-- ===== Game folder card ===== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                        Background="#FF16233A" Margin="0,0,12,0">
                    <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GAME FOLDER" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox Text="{Binding GameFolderPath, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" MinHeight="0" Padding="0"
                             Foreground="{DynamicResource ForegroundBrush}" FontSize="13"
                             ToolTip="{Binding GameFolderPath}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseGameFolderCommand}"
                        Margin="12,0,0,0" Padding="16,8" Style="{DynamicResource GhostButtonStyle}"/>
                <Button Grid.Column="3" Content="Auto" Command="{Binding AutoDetectGameFolderCommand}"
                        Margin="8,0,0,0" Padding="16,8" Style="{DynamicResource GhostButtonStyle}"
                        ToolTip="Detect automatically"/>
            </Grid>
        </Border>

        <!-- ===== Toolbar: только профили ===== -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PROFILES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  MinWidth="140" Width="190" Margin="0,0,8,0"
                                  IsEnabled="{Binding IsNotBusy}"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  ToolTip="Profiles"/>
                        <Button Content="Save" Command="{Binding SaveProfileCommand}"
                                Padding="14,7" Margin="0,0,8,0" Style="{DynamicResource GhostButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}" ToolTip="Save the current mod set as a profile"/>
                        <Button Content="Delete" Command="{Binding DeleteProfileCommand}"
                                Padding="14,7"
                                Style="{DynamicResource DangerButtonStyle}"
                                IsEnabled="{Binding SelectedProfile, Converter={StaticResource SelectedProfileNotEmptyConverter}}"
                                ToolTip="Delete the selected profile"/>
                    </WrapPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="8,0,0,4">
                    <Button Content="Check updates" Command="{Binding CheckUpdatesCommand}"
                            Padding="14,7" BorderThickness="0"
                            Style="{DynamicResource GhostButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Compare installed versions with Nexus"/>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="8,0,0,4">
                    <Button Content="{Binding BackupsButtonText}" Command="{Binding ToggleBackupsCommand}"
                            Padding="14,7" BorderThickness="0"
                            Style="{DynamicResource GhostButtonStyle}"
                            ToolTip="Deleted mods: restore or delete forever"/>
                </Border>
            </WrapPanel>
        </StackPanel>

        <!-- ===== Mods list card ===== -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Actions + search row -->
                <Grid Grid.Row="0" Margin="10,4,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                 Visibility="{Binding ShowBackups, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button Content="Refresh" Command="{Binding RefreshModsCommand}"
                                Padding="12,6" Margin="0,0,8,0" Style="{DynamicResource GhostButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Enable all" Command="{Binding EnableAllModsCommand}"
                                Padding="12,6" Margin="0,0,8,0" Style="{DynamicResource GhostButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="Disable all" Command="{Binding DisableAllModsCommand}"
                                Padding="12,6" Margin="0,0,8,0" Style="{DynamicResource GhostButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}"
                                  Width="110" Margin="0,0,4,0" ToolTip="Sort by"
                                  IsEnabled="{Binding IsNotBusy}"/>
                        <Button Content="{Binding SortDirectionLabel}" Command="{Binding ToggleSortDirectionCommand}"
                                Padding="10,6" Margin="0,0,8,0" Style="{DynamicResource GhostButtonStyle}"
                                ToolTip="Sort order"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter}"
                                  Width="110" Margin="0,0,8,0" ToolTip="Filter by status"
                                  IsEnabled="{Binding IsNotBusy}"/>
                    </WrapPanel>
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                               Visibility="{Binding ShowBackups, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="BACKUPS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Delete all" Command="{Binding DeleteAllBackupsCommand}"
                                Padding="12,6" Margin="0,0,8,0" Style="{DynamicResource DangerButtonStyle}"
                                ToolTip="Permanently delete all backups"/>
                    </WrapPanel>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" MinHeight="32"
                             ToolTip="Search by name / author / version"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8"
                      Visibility="{Binding ShowBackups, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="MOD" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="VERSION" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Visibility="{Binding ShowBackups, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView x:Name="ModsList" ItemsSource="{Binding Mods}"
                                  SelectedItem="{Binding SelectedMod}"
                                  SelectionMode="Extended"
                                  PreviewMouseLeftButtonDown="ModsList_ClickEmptyDeselect"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,6" Margin="2,0,6,6" BorderThickness="1" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF101724"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="#FF14203A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" ToolTip="Enable / disable"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF5B657D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="16,1,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                        <Border Background="#FF16233A" CornerRadius="6"
                                                Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Version, TargetNullValue='—'}" FontSize="12"
                                                       Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#FF1A2E1A" CornerRadius="6"
                                                Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTip="Newer version on Nexus">
                                            <TextBlock Text="↑ update" FontSize="11"
                                                       Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Open" Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Padding="8,5" Margin="0,0,6,0"
                                                Style="{DynamicResource IconButtonStyle}" ToolTip="Open mod folder"/>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Padding="8,5"
                                                Style="{DynamicResource DangerButtonStyle}" ToolTip="Delete mod"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Mods.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="No mods found" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,8,0,2"/>
                            <TextBlock Text="Install a mod or select the game folder" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Backups list -->
                    <Grid Grid.Column="0"
                          Visibility="{Binding ShowBackups, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView x:Name="BackupsList" ItemsSource="{Binding Backups}"
                                  SelectedItem="{Binding SelectedBackup}"
                                  SelectionMode="Single"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="2,0,6,6" BorderThickness="1" CornerRadius="6"
                                            Background="#FF101724" BorderBrush="{DynamicResource BorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⛁" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ModName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding BackupFolder}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CreatedText}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Restore"
                                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Padding="10,5" Margin="0,0,6,0"
                                                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Restore to Mods"/>
                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.DeleteBackupForeverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Padding="10,5"
                                                        Style="{DynamicResource DangerButtonStyle}" ToolTip="Delete forever"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Backups.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="⛁" FontSize="40" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="No backups" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,8,0,2"/>
                            <TextBlock Text="Deleted and overwritten mods land here" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Details pane (скрыта, пока ничего не выбрано) ===== -->
                    <Border Grid.Column="1" Width="280" Background="#FF101724" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,2,0"
                            Visibility="{Binding ShowModDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedMod.Name, TargetNullValue='—'}" FontSize="16"
                                           FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedMod.Author, TargetNullValue=''}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,8"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#FF16233A" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedMod.Version, TargetNullValue='—'}" FontSize="12"
                                                   Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#FF16233A" CornerRadius="6" Padding="8,4">
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedMod.IsEnabled}" Value="True">
                                                            <Setter Property="Text" Value="Enabled"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedMod.IsEnabled}" Value="False">
                                                            <Setter Property="Text" Value="Disabled"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedMod.NexusVersion, StringFormat='↑ Nexus v{0} available!'}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Visibility="{Binding SelectedMod.HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedMod.Description, TargetNullValue='No description.'}"
                                           FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" MaxHeight="140"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Content="Website" Command="{Binding OpenWebsiteCommand}"
                                        CommandParameter="{Binding SelectedMod.Website}"
                                        Padding="10,6" Margin="0,0,0,8" Style="{DynamicResource GhostButtonStyle}"
                                        IsEnabled="{Binding SelectedMod.Website, Converter={StaticResource SelectedProfileNotEmptyConverter}}"/>
                                <TextBlock Text="FOLDER" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedMod.FolderPath, TargetNullValue='—'}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Content="Open folder" Command="{Binding OpenModFolderCommand}"
                                        CommandParameter="{Binding SelectedMod}"
                                        Padding="10,6" Margin="0,0,0,8" Style="{DynamicResource GhostButtonStyle}"/>
                                <TextBlock Text="ACTIONS (selected in list)" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Enable" Command="{Binding EnableSelectedModsCommand}"
                                            Padding="10,6" Margin="0,0,6,4" Style="{DynamicResource GhostButtonStyle}"/>
                                    <Button Content="Disable" Command="{Binding DisableSelectedModsCommand}"
                                            Padding="10,6" Margin="0,0,6,4" Style="{DynamicResource GhostButtonStyle}"/>
                                    <Button Content="Delete" Command="{Binding DeleteSelectedModsCommand}"
                                            Padding="10,6" Margin="0,0,0,4" Style="{DynamicResource DangerButtonStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ===== Backup details pane ===== -->
                    <Border Grid.Column="1" Width="280" Background="#FF101724" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,2,0"
                            Visibility="{Binding ShowBackupDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="BACKUP" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedBackup.ModName}" FontSize="16"
                                           FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedBackup.BackupFolder}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="{Binding SelectedBackup.CreatedText, StringFormat='Saved: {0}'}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedBackup.SizeText, StringFormat='Size: {0}'}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"/>
                                <Button Content="Restore to Mods" Command="{Binding RestoreBackupCommand}"
                                        CommandParameter="{Binding SelectedBackup}"
                                        Padding="10,6" Margin="0,0,0,8" Style="{DynamicResource AccentButtonStyle}"/>
                                <Button Content="Delete forever" Command="{Binding DeleteBackupForeverCommand}"
                                        CommandParameter="{Binding SelectedBackup}"
                                        Padding="10,6" Style="{DynamicResource DangerButtonStyle}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Floating bottom overlay: progress + toast ===== -->
        <StackPanel Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,12" Panel.ZIndex="10">
            <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#DD101724" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="1"
                                 Width="240" Height="8" VerticalAlignment="Center"/>
                    <Button Content="Cancel" Command="{Binding CancelInstallCommand}" Margin="10,0,0,0"
                            Padding="10,4" Style="{DynamicResource DangerButtonStyle}" ToolTip="Cancel install"/>
                </StackPanel>
            </Border>
            <Border Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#DD101724" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,8" IsHitTestVisible="False"
                    HorizontalAlignment="Center" MaxWidth="700">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
