<Window x:Class="SevenDaysModLauncher.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="7daysModLauncher"
        SizeToContent="Height" Width="440"
        MinHeight="160" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="20" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse x:Name="AccentDot" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton" MinWidth="100" Padding="14,7"
                        Style="{DynamicResource AccentButtonStyle}" IsDefault="True"
                        Click="PrimaryButton_Click"/>
                <Button x:Name="SecondaryButton" MinWidth="100" Padding="14,7" Margin="8,0,0,0"
                        Style="{DynamicResource GhostButtonStyle}" IsCancel="True"
                        Click="SecondaryButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
