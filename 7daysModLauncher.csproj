<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SevenDaysModLauncher</RootNamespace>
    <AssemblyName>7daysModLauncher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <!-- Тесты лежат внутри репозитория — исключить из сборки приложения -->
  <ItemGroup>
    <Compile Remove="7daysModLauncher.Tests/**/*.cs" />
    <EmbeddedResource Remove="7daysModLauncher.Tests/**/*" />
    <None Remove="7daysModLauncher.Tests/**/*" />
    <Page Remove="7daysModLauncher.Tests/**/*" />
  </ItemGroup>

</Project>
